%%%
# Finite-window Poisson point processes

For event intensities lambda[n] and observed integral Lambda, the configuration
log score is sum(log(lambda)) - Lambda. Labelled points subtract log(n!).
%%%
flatppl_compat = "0.1"
likelihoods = load_module("src/likelihoods.flatppl")
intensities = load_module("src/intensities.flatppl")
configuration_loglikelihood = likelihoods.configuration_loglikelihood
labelled_loglikelihood = likelihoods.labelled_loglikelihood
conditional_labelled_loglikelihood = likelihoods.conditional_labelled_loglikelihood
signal_background_intensity = intensities.signal_background_intensity
detected_intensity = intensities.detected_intensity
marked_intensity = intensities.marked_intensity
quadrature_integral = intensities.quadrature_integral
